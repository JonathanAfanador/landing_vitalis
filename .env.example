# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.

# --- Base de datos (Neon, Fase 3) ---
# Conexión de la app: Neon > Connect > "Connection pooling" activado (el host lleva -pooler), con el rol vitalis_app.
DATABASE_URL="postgresql://vitalis_app:<password>@ep-<id>-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexión directa: Neon > Connect > "Connection pooling" desactivado, con el rol dueño. Solo para migraciones y seed.
DATABASE_URL_MIGRACIONES="postgresql://neondb_owner:<password>@ep-<id>.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Seguridad (Fase 3 y 4) ---
# Sal para el hash de la IP del rate limit. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""
