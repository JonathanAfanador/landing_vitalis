# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.

# --- Base de datos (Neon, Fase 3) ---
# Conexión de la app: Neon > Connect > "Connection pooling" activado (el host lleva -pooler), con el rol vitalis_app.
DATABASE_URL="postgresql://vitalis_app:<password>@ep-<id>-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Conexión directa: Neon > Connect > "Connection pooling" desactivado, con el rol dueño. Solo para migraciones y seed.
DATABASE_URL_MIGRACIONES="postgresql://neondb_owner:<password>@ep-<id>.us-east-1.aws.neon.tech/neondb?sslmode=verify-full"

# Conexión del panel /admin: igual que DATABASE_URL (con pooling) pero con el rol vitalis_admin.
# Solo la usan el panel y el login; las páginas públicas nunca la tocan.
DATABASE_URL_ADMIN="postgresql://vitalis_admin:<password>@ep-<id>-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Conexión del portal de clientes (/cuenta): igual que DATABASE_URL (con pooling) pero con el rol vitalis_cuenta.
# Solo lee y toca los datos del cliente con sesión; la base lo garantiza con RLS (Fase 4D).
DATABASE_URL_CUENTA="postgresql://vitalis_cuenta:<password>@ep-<id>-pooler.us-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# Correo del primer superadmin. Lo lee `pnpm db:crear-superadmin` (la contraseña se pide por consola, nunca aquí).
SUPERADMIN_EMAIL=""

# --- Seguridad (Fase 3 y 4) ---
# Sal para los HMAC de IP (límite de envíos) y de correo (límite de intentos de login). Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""
