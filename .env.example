# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.

# --- Base de datos (Supabase, Fase 3) ---
# Conexión de la app: pooler de Supabase en modo transacción (puerto 6543), con el rol vitalis_app.
# Supabase > Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL="postgresql://vitalis_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Conexión directa (puerto 5432) con el rol postgres. Solo para migraciones y seed, nunca en la app.
DATABASE_URL_MIGRACIONES="postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres"

# --- Seguridad (Fase 3 y 4) ---
# Sal para el hash de la IP del rate limit. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=""
