---
import { actions, isInputError } from 'astro:actions';
import Pagina from '../layouts/Pagina.astro';
import Aviso from '../components/ui/Aviso.astro';
import Campo from '../components/formularios/Campo.astro';
import Icono from '../components/ui/Icono.astro';
import Pending from '../components/ui/Pending.astro';
import { contacto } from '../data/vitalis';
import { medicamentosParaPedido } from '../db/queries/medicamentos';
import { leerCarrito } from '../lib/carrito-cookies';
import { formatoCOP, formatoTelefono } from '../lib/formato';
import { calcularPedido } from '../lib/pedido';
import { registrarError } from '../lib/registro';
import { enlaceWhatsApp, mensajePedido } from '../lib/whatsapp';

export const prerender = false;
// Página de cada persona: nunca entra en ninguna caché.
Astro.response.headers.set('Cache-Control', 'private, no-store');

// Cambiar una cantidad redirige aquí mismo: así recargar no reenvía el formulario.
const cambio = Astro.getActionResult(actions.carrito.cambiar);
if (cambio?.data) return Astro.redirect('/pedido', 303);

const envio = Astro.getActionResult(actions.pedidos.crear);
const pedido = envio?.data ?? null;
const errores = envio?.error && isInputError(envio.error) ? envio.error.fields : {};
const errorGeneral =
  (envio?.error && !isInputError(envio.error) ? envio.error.message : null) ?? cambio?.error?.message;
// Si el envío falló, se vuelven a rellenar los campos con lo que se escribió.
const enviado = envio?.error ? await Astro.request.formData() : null;
// Pedir exige cuenta de cliente: sus datos salen de la cuenta. Sin sesión se ve el carrito y se invita a
// ingresar o registrarse (el carrito sigue en su cookie y vuelve aquí).
const cliente = Astro.locals.usuario?.rolSlug === 'usuario' ? Astro.locals.usuario : null;
const delPanel = Boolean(Astro.locals.usuario && !cliente);
const valor = (campo: string) => String(enviado?.get(campo) ?? '') || undefined;
const primerError = (campo: keyof typeof errores) => errores[campo]?.[0];

const items = pedido ? [] : leerCarrito(Astro.cookies);
let calculo: ReturnType<typeof calcularPedido> | null = null;
let fallo = false;
if (items.length) {
  try {
    calculo = calcularPedido(items, await medicamentosParaPedido(items.map((i) => i.slug)));
  } catch (error) {
    registrarError('pedido', error);
    fallo = true;
  }
}

const whatsapp = pedido ? enlaceWhatsApp(contacto.whatsapp, mensajePedido(pedido)) : null;
const accionCambiar = actions.carrito.cambiar.toString();
const filas = calculo
  ? items.map((item) => ({
      ...item,
      linea: calculo.lineas.find((l) => l.slug === item.slug),
      problema: calculo.problemas.find((p) => p.slug === item.slug),
    }))
  : [];
---

<Pagina
  titulo="Tu pedido · Vitalis"
  descripcion="Revisa tu pedido de medicamentos veterinarios y deja tus datos."
  noindex
>
  <div class="mx-auto max-w-6xl">
    <p class="caption-3 text-dorado-700">Pedido</p>
    <h1 class="heading-2 mt-3">{pedido ? 'Recibimos tu pedido' : 'Tu pedido'}</h1>

    {errorGeneral && (
      <Aviso tipo="error" class="mt-6">
        {errorGeneral}
      </Aviso>
    )}

    {pedido ? (
      <section class="mt-8 rounded-3xl border border-azul-900/10 p-6 text-center sm:p-12">
        <span class="mx-auto grid size-12 place-items-center rounded-full bg-dorado-400/25 text-dorado-700">
          <Icono nombre="check-circle" />
        </span>
        <p class="body-3 mt-6 text-tinta-600">
          Tu código es <strong class="font-semibold text-azul-900">{pedido.codigo}</strong>. Total:
          <strong class="font-semibold text-azul-900">{formatoCOP(pedido.totalCop)}</strong>.
        </p>
        <p class="body-3 mt-2 text-tinta-600">
          Te escribiremos por WhatsApp para confirmar disponibilidad y enviarte los datos de pago. Cuando esté
          pagado, lo recoges en la clínica.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          {whatsapp && (
            <a href={whatsapp} class="btn-principal" target="_blank" rel="noopener">
              <Icono nombre="whatsapp-logo" class="size-5" />
              Confirmar por WhatsApp
            </a>
          )}
          <a href={cliente ? '/cuenta' : '/tienda'} class="btn-borde">
            {cliente ? 'Ver en mi cuenta' : 'Volver a la tienda'}
          </a>
        </div>
        {!whatsapp && <Pending dato="número de WhatsApp para el botón de confirmación" class="mt-4" />}
      </section>
    ) : fallo ? (
      <div
        class="mt-8 flex flex-col items-center rounded-3xl border border-azul-900/10 px-6 py-16 text-center"
        role="alert"
      >
        <h2 class="heading-5">No pudimos cargar tu pedido</h2>
        <p class="body-3 mt-2 text-tinta-600">Vuelve a intentarlo en unos segundos.</p>
        <a href="/pedido" class="btn-principal mt-6">
          Reintentar
        </a>
      </div>
    ) : !calculo ? (
      <div class="mt-8 flex flex-col items-center rounded-3xl border border-azul-900/10 px-6 py-16 text-center">
        <span class="grid size-12 place-items-center rounded-full bg-dorado-400/25 text-dorado-700">
          <Icono nombre="shopping-bag" />
        </span>
        <h2 class="heading-5 mt-6">Tu pedido está vacío</h2>
        <p class="body-3 mt-2 max-w-md text-tinta-600">
          Busca los medicamentos de tu mascota y agrégalos desde la tienda.
        </p>
        <a href="/tienda" class="btn-principal mt-6">
          Ir a la tienda
        </a>
      </div>
    ) : (
      <div class="mt-8 grid gap-10 lg:grid-cols-[3fr_2fr] lg:items-start">
        <section aria-labelledby="titulo-lista">
          <h2 id="titulo-lista" class="sr-only">
            Medicamentos de tu pedido
          </h2>
          <ul class="divide-y divide-azul-900/10 border-y border-azul-900/10">
            {filas.map(({ slug, cantidad, linea, problema }) => {
              const nombre = linea?.nombre ?? 'Medicamento no disponible';
              const maximo = linea ? Math.min(linea.stock, 99) : 0;
              return (
                <li class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 py-4 sm:flex sm:gap-4">
                  <div class="col-span-2 sm:flex-1">
                    <p class="title-2">{nombre}</p>
                    {linea && <p class="body-6 text-tinta-600">{formatoCOP(linea.precioUnitarioCop)} c/u</p>}
                    {problema && (
                      <p class="body-6 text-error-700">
                        {problema.motivo === 'no-disponible'
                          ? 'Ya no está disponible. Quítalo para continuar.'
                          : `Solo quedan ${problema.disponible}. Ajusta la cantidad.`}
                      </p>
                    )}
                  </div>
                  {linea && (
                    <div class="flex w-fit items-center rounded-full border border-azul-900/20">
                      <form method="POST" action={accionCambiar}>
                        <input type="hidden" name="slug" value={slug} />
                        <input type="hidden" name="cantidad" value={cantidad - 1} />
                        <button
                          type="submit"
                          class="grid size-11 place-items-center rounded-full hover:bg-arena-100"
                          aria-label={`Quitar una unidad de ${nombre}`}
                        >
                          <Icono nombre="minus" class="size-4" />
                        </button>
                      </form>
                      <span class="w-8 text-center tabular-nums">{cantidad}</span>
                      <form method="POST" action={accionCambiar}>
                        <input type="hidden" name="slug" value={slug} />
                        <input type="hidden" name="cantidad" value={Math.min(cantidad + 1, maximo)} />
                        <button
                          type="submit"
                          class="grid size-11 place-items-center rounded-full hover:bg-arena-100 disabled:opacity-40"
                          aria-label={`Agregar una unidad de ${nombre}`}
                          disabled={cantidad >= maximo}
                        >
                          <Icono nombre="plus" class="size-4" />
                        </button>
                      </form>
                    </div>
                  )}
                  <div class="flex items-center justify-end gap-2">
                    <p class="title-3 w-24 text-right tabular-nums">
                      {linea ? formatoCOP(linea.subtotalCop) : ''}
                    </p>
                    <form method="POST" action={accionCambiar}>
                      <input type="hidden" name="slug" value={slug} />
                      <input type="hidden" name="cantidad" value="0" />
                      <button
                        type="submit"
                        class="grid size-11 place-items-center rounded-full text-tinta-600 hover:bg-arena-100 hover:text-error-700"
                        aria-label={`Quitar ${nombre} del pedido`}
                      >
                        <Icono nombre="trash" class="size-5" />
                      </button>
                    </form>
                  </div>
                </li>
              );
            })}
          </ul>
          <dl class="mt-6 flex items-baseline justify-between">
            <dt class="title-1">Total</dt>
            <dd class="heading-5">{formatoCOP(calculo.totalCop)}</dd>
          </dl>
          <p class="caption-5 mt-2 text-tinta-600">
            Te confirmamos por WhatsApp y te enviamos los datos para pagar por transferencia. Lo recoges en la
            clínica.
          </p>
        </section>

        <section aria-labelledby="titulo-datos" class="rounded-3xl bg-arena-100 p-6">
          <h2 id="titulo-datos" class="heading-5">
            {cliente ? 'Tus datos' : 'Para enviar tu pedido'}
          </h2>
          {cliente ? (
            <form method="POST" action={actions.pedidos.crear} class="mt-6 flex flex-col gap-4">
              <dl class="body-6 flex flex-col gap-2 rounded-2xl bg-crema-50 p-4">
                <div>
                  <dt class="text-tinta-600">Nombre</dt>
                  <dd>{cliente.nombre}</dd>
                </div>
                <div>
                  <dt class="text-tinta-600">Celular</dt>
                  <dd>
                    {cliente.telefono ? formatoTelefono(cliente.telefono) : 'Falta: agrégalo en tu perfil'}
                  </dd>
                </div>
                <div>
                  <dt class="text-tinta-600">Correo</dt>
                  <dd>{cliente.email}</dd>
                </div>
                <a href="/cuenta/perfil" class="caption-5 mt-1 underline underline-offset-4">
                  ¿Cambiaron? Actualízalos en tu perfil
                </a>
              </dl>
              <Campo
                name="notas"
                etiqueta="Notas"
                multilinea
                maxlength={500}
                value={valor('notas')}
                error={primerError('notas')}
              />

              {calculo.requiereFormula && (
                <div class="rounded-2xl bg-crema-50 p-4">
                  <p class="body-6 flex gap-2">
                    <Icono nombre="prescription" class="size-5 shrink-0 text-dorado-700" />
                    Tu pedido incluye medicamentos que requieren fórmula médica veterinaria.
                  </p>
                  <label class="body-6 mt-3 flex gap-3">
                    <input
                      type="checkbox"
                      name="declaraFormula"
                      required
                      checked={enviado?.has('declaraFormula')}
                      class="mt-0.5 size-5 shrink-0 accent-azul-900"
                    />
                    Tengo la fórmula y la enviaré por WhatsApp.
                  </label>
                </div>
              )}

              <button
                type="submit"
                class="btn-principal w-full disabled:cursor-not-allowed disabled:opacity-60"
                disabled={calculo.problemas.length > 0}
              >
                Enviar pedido
              </button>
              <p class="caption-5 text-center text-tinta-600">
                Quedará guardado en{' '}
                <a href="/cuenta" class="underline underline-offset-4">
                  tu cuenta
                </a>
                .
              </p>
              {calculo.problemas.length > 0 && (
                <p class="body-6 text-error-700">
                  Ajusta los medicamentos marcados en rojo para poder enviar el pedido.
                </p>
              )}
            </form>
          ) : delPanel ? (
            <p class="body-3 mt-4">
              Ingresaste con una cuenta del panel. Para hacer un pedido, usa una cuenta de cliente.
            </p>
          ) : (
            <div class="mt-4 flex flex-col gap-4">
              <p class="body-3 text-tinta-600">
                Ingresa o crea tu cuenta: así no escribes tus datos cada vez y ves el estado de tus pedidos.
                Tu carrito te espera aquí.
              </p>
              <a href="/cuenta/ingresar?volver=/pedido" class="btn-principal w-full">
                Ingresar
              </a>
              <a href="/cuenta/registro?volver=/pedido" class="btn-borde w-full">
                Crear cuenta
              </a>
            </div>
          )}
        </section>
      </div>
    )}
  </div>
</Pagina>
