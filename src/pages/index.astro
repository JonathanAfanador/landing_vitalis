---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import WhatsAppFlotante from '../components/layout/WhatsAppFlotante.astro';
import ScrollWorld from '../components/portada/ScrollWorld.astro';
import Servicios from '../components/portada/Servicios.astro';
import Tagline from '../components/portada/Tagline.astro';
import Doctor from '../components/portada/Doctor.astro';
import AccesoTienda from '../components/portada/AccesoTienda.astro';
import ComoPedir from '../components/portada/ComoPedir.astro';
import PorQue from '../components/portada/PorQue.astro';
import Testimonios from '../components/portada/Testimonios.astro';
import Ubicacion from '../components/portada/Ubicacion.astro';
import Valoracion from '../components/portada/Valoracion.astro';
import Faq from '../components/portada/Faq.astro';
import CtaFinal from '../components/portada/CtaFinal.astro';
---

<Layout>
  <SkipLink />
  <Header />
  <main id="contenido">
    <ScrollWorld />
    <Servicios />
    <Tagline />
    <Doctor />
    <AccesoTienda />
    <ComoPedir />
    <PorQue />
    <Testimonios />
    <Ubicacion />
    <Valoracion />
    <Faq />
    <CtaFinal />
  </main>
  <Footer />
  <WhatsAppFlotante />
</Layout>

<script>
  import '../scripts/motion';
</script>
