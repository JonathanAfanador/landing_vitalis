---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Paginacion from '../../../components/admin/Paginacion.astro';
import SinPermiso from '../../../components/admin/SinPermiso.astro';
import Icono from '../../../components/ui/Icono.astro';
import { can } from '../../../admin/autorizacion';
import { leerFiltroCitas, listarCitasPanel } from '../../../admin/citas';
import { permisoDePagina } from '../../../admin/guard';
import { leerPagina, totalPaginas } from '../../../admin/paginacion';
import { ELIMINAR_REGISTROS } from '../../../admin/permisos';
import { ESTADOS_CITA, NOMBRE_ESTADO_CITA } from '../../../lib/estados';
import { preferenciaCita } from '../../../lib/whatsapp';

export const prerender = false;

const actor = permisoDePagina(Astro, 'citas:ver');
const veEliminadas = can(actor, ELIMINAR_REGISTROS);
const estado = leerFiltroCitas(Astro.url.searchParams.get('estado'), veEliminadas);
const pagina = leerPagina(Astro.url.searchParams.get('pagina'));
const { citas, total } = actor ? await listarCitasPanel({ estado, pagina }) : { citas: [], total: 0 };
// Una página que ya no existe (por ejemplo, tras eliminar) lleva a la última que sí.
if (actor && pagina > totalPaginas(total)) {
  const url = new URL(Astro.url);
  url.searchParams.set('pagina', String(totalPaginas(total)));
  return Astro.redirect(url.pathname + url.search, 303);
}
const FILTROS = [
  { valor: null, texto: 'Todas' },
  ...ESTADOS_CITA.map((e) => ({ valor: e, texto: NOMBRE_ESTADO_CITA[e] })),
  ...(veEliminadas ? [{ valor: 'eliminadas' as const, texto: 'Eliminadas' }] : []),
];
const descarga = `/admin/citas/exportar${estado ? `?estado=${estado}` : ''}`;
const fecha = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'America/Bogota',
});
const color: Record<string, string> = {
  solicitada: 'bg-dorado-400/30 text-azul-900',
  confirmada: 'bg-azul-led/10 text-azul-led',
  atendida: 'bg-arena-100 text-tinta-600',
  no_asistio: 'bg-error-700/10 text-error-700',
  cancelada: 'bg-error-700/10 text-error-700',
};
---

<AdminLayout titulo="Citas">
  {!actor ? (
    <SinPermiso />
  ) : (
    <>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h1 class="heading-3">Citas</h1>
        {can(actor, 'citas:exportar') && total > 0 && (
          <a href={descarga} class="btn-borde" download>
            <Icono nombre="arrow-down" class="size-5" />
            Descargar Excel
          </a>
        )}
      </div>
      <p class="body-6 mt-2 max-w-2xl text-tinta-600">
        Solicitudes del formulario de la web. El horario se acuerda con el tutor por WhatsApp; cuando quede
        definido, marca la cita como agendada y anota el día y la hora.
      </p>
      <nav aria-label="Filtrar por estado" class="mt-6 flex flex-wrap gap-2">
        {FILTROS.map(({ valor, texto }) => (
          <a
            href={valor ? `/admin/citas?estado=${valor}` : '/admin/citas'}
            aria-current={valor === estado ? 'page' : undefined}
            class:list={[
              'btn-borde min-h-10 px-4 text-sm aria-[current=page]:bg-azul-900 aria-[current=page]:text-crema-50',
              valor === 'eliminadas' && 'border-error-700/40 text-error-700',
            ]}
          >
            {texto}
          </a>
        ))}
      </nav>

      {citas.length ? (
        <div class="mt-8 rounded-3xl border border-azul-900/10 md:overflow-x-auto">
          <table class="block w-full text-left md:table md:min-w-3xl">
            <thead class="caption-3 hidden bg-arena-100 text-dorado-700 md:table-header-group">
              <tr>
                <th scope="col" class="px-4 py-3">
                  Código
                </th>
                <th scope="col" class="px-4 py-3">
                  Recibida
                </th>
                <th scope="col" class="px-4 py-3">
                  Tutor
                </th>
                <th scope="col" class="px-4 py-3">
                  Mascota
                </th>
                <th scope="col" class="px-4 py-3">
                  Prefiere
                </th>
                <th scope="col" class="px-4 py-3">
                  Estado
                </th>
                <th scope="col" class="px-4 py-3">
                  <span class="sr-only">Acciones</span>
                </th>
              </tr>
            </thead>
            <tbody class="body-6 block divide-y divide-azul-900/10 md:table-row-group">
              {citas.map((c) => (
                <tr class="block py-2 md:table-row md:py-0">
                  <td class="block px-4 py-1 md:table-cell md:py-3">
                    <a
                      href={`/admin/citas/${c.id}`}
                      class="title-3 underline decoration-dorado-400 underline-offset-4"
                    >
                      {c.codigo}
                    </a>
                  </td>
                  <td class="block px-4 py-1 text-tinta-600 md:table-cell md:py-3">
                    {fecha.format(c.fecha)}
                  </td>
                  <td class="block px-4 py-1 md:table-cell md:py-3">{c.tutor}</td>
                  <td class="block px-4 py-1 md:table-cell md:py-3">{c.mascota}</td>
                  <td class="block px-4 py-1 text-tinta-600 first-letter:uppercase md:table-cell md:py-3">
                    {preferenciaCita(c.fechaPreferida, c.franja)}
                  </td>
                  <td class="block px-4 py-2 md:table-cell md:py-3">
                    <span class:list={['caption-3 rounded-full px-2 py-1', color[c.estado]]}>
                      {NOMBRE_ESTADO_CITA[c.estado]}
                    </span>
                    {estado === 'eliminadas' && (
                      <span class="caption-3 ml-1 rounded-full bg-error-700/10 px-2 py-1 text-error-700">
                        Eliminada
                      </span>
                    )}
                  </td>
                  <td class="block px-4 py-2 md:table-cell md:py-3 md:text-right">
                    <a
                      href={`/admin/citas/${c.id}`}
                      class="btn-borde min-h-10 px-4 text-sm"
                      aria-label={`Gestionar cita ${c.codigo}`}
                    >
                      Gestionar
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="body-3 mt-8 rounded-3xl bg-arena-100 p-6">
          {estado === 'eliminadas'
            ? 'No hay citas eliminadas.'
            : `No hay citas ${estado ? 'en este estado' : 'todavía'}.`}
        </p>
      )}
      <Paginacion pagina={pagina} total={total} nombre={total === 1 ? 'cita' : 'citas'} />
    </>
  )}
</AdminLayout>
