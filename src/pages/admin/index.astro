---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icono from '../../components/ui/Icono.astro';
import { can } from '../../admin/autorizacion';
import { GESTIONAR_ROLES, type Capacidad } from '../../admin/permisos';
import { contarCitasPorAgendar } from '../../admin/citas';
import { contarSolicitudesEliminacion } from '../../admin/clientes';
import { contarPedidosPendientes } from '../../admin/pedidos';
import type { NombreIcono } from '../../lib/iconos';

export const prerender = false;

const usuario = Astro.locals.usuario;
const accesos: { titulo: string; texto: string; href: string; icono: NombreIcono; capacidad: Capacidad }[] = [
  {
    titulo: 'Pedidos',
    texto: 'Confirmar, marcar como pagados y entregar los pedidos de la tienda.',
    href: '/admin/pedidos',
    icono: 'shopping-bag',
    capacidad: 'pedidos:ver',
  },
  {
    titulo: 'Citas',
    texto: 'Solicitudes de la web: agendar por WhatsApp, anotar el horario y marcar asistencia.',
    href: '/admin/citas',
    icono: 'calendar-check',
    capacidad: 'citas:ver',
  },
  {
    titulo: 'Medicamentos',
    texto: 'Catálogo, precios, stock y medicamentos activos en la tienda.',
    href: '/admin/medicamentos',
    icono: 'pill',
    capacidad: 'medicamentos:ver',
  },
  {
    titulo: 'Categorías',
    texto: 'Cómo se agrupan los medicamentos en la tienda.',
    href: '/admin/categorias',
    icono: 'package',
    capacidad: 'categorias:gestionar',
  },
  {
    titulo: 'Clientes',
    texto: 'Cuentas creadas en la web: restablecer contraseñas y desactivar cuentas.',
    href: '/admin/clientes',
    icono: 'user-circle',
    capacidad: 'clientes:ver',
  },
  {
    titulo: 'Usuarios',
    texto: 'Cuentas del panel, roles asignados y contraseñas.',
    href: '/admin/usuarios',
    icono: 'person-simple-walk',
    capacidad: 'usuarios:ver',
  },
  {
    titulo: 'Roles y permisos',
    texto: 'Qué puede hacer cada rol dentro del panel.',
    href: '/admin/roles',
    icono: 'shield-check',
    capacidad: GESTIONAR_ROLES,
  },
  {
    titulo: 'Auditoría',
    texto: 'Registro de ingresos, cambios de roles y operaciones.',
    href: '/admin/auditoria',
    icono: 'path',
    capacidad: 'auditoria:ver',
  },
];
const visibles = accesos.filter((a) => can(usuario, a.capacidad));
// Solo un número, sin datos de clientes.
const [pendientes, porAgendar, solicitudes] = await Promise.all([
  can(usuario, 'pedidos:ver') ? contarPedidosPendientes() : null,
  can(usuario, 'citas:ver') ? contarCitasPorAgendar() : null,
  can(usuario, 'clientes:ver') ? contarSolicitudesEliminacion() : null,
]);
---

<AdminLayout titulo="Resumen">
  <h1 class="heading-3">Hola, {usuario?.nombre}</h1>
  <p class="body-3 mt-2 text-tinta-600">Tu rol es {usuario?.rolNombre}.</p>
  {(pendientes !== null || porAgendar !== null || Boolean(solicitudes)) && (
    <div class="mt-6 flex flex-wrap gap-3">
      {pendientes !== null && (
        <a
          href="/admin/pedidos?estado=pendiente"
          class="inline-flex items-center gap-3 rounded-full bg-azul-900 py-2 pr-5 pl-2 text-crema-50"
        >
          <span class="grid size-10 place-items-center rounded-full bg-dorado-400 font-semibold text-azul-900 tabular-nums">
            {pendientes}
          </span>
          <span class="body-1">
            {pendientes === 1 ? 'pedido pendiente' : 'pedidos pendientes'} por confirmar
          </span>
        </a>
      )}
      {porAgendar !== null && (
        <a
          href="/admin/citas?estado=solicitada"
          class="inline-flex items-center gap-3 rounded-full bg-azul-900 py-2 pr-5 pl-2 text-crema-50"
        >
          <span class="grid size-10 place-items-center rounded-full bg-dorado-400 font-semibold text-azul-900 tabular-nums">
            {porAgendar}
          </span>
          <span class="body-1">{porAgendar === 1 ? 'cita' : 'citas'} por agendar</span>
        </a>
      )}
      {solicitudes ? (
        <a
          href="/admin/clientes?ver=solicitudes"
          class="inline-flex items-center gap-3 rounded-full bg-error-700 py-2 pr-5 pl-2 text-crema-50"
        >
          <span class="grid size-10 place-items-center rounded-full bg-crema-50 font-semibold text-error-700 tabular-nums">
            {solicitudes}
          </span>
          <span class="body-1">
            {solicitudes === 1 ? 'solicitud' : 'solicitudes'} de eliminación de cuenta
          </span>
        </a>
      ) : null}
    </div>
  )}

  {visibles.length ? (
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {visibles.map((a) => (
        <li>
          <a
            href={a.href}
            class="flex h-full flex-col gap-4 rounded-3xl bg-arena-100 p-6 transition duration-300 ease-base hover:bg-dorado-400/30"
          >
            <span class="grid size-12 place-items-center rounded-full bg-crema-50 text-dorado-700">
              <Icono nombre={a.icono} />
            </span>
            <span class="title-1">{a.titulo}</span>
            <span class="body-6 text-tinta-600">{a.texto}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="body-3 mt-8 rounded-3xl bg-arena-100 p-6">
      Tu rol todavía no tiene secciones disponibles. Pide a un superadmin que te asigne permisos.
    </p>
  )}
</AdminLayout>
