---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Paginacion from '../../../components/admin/Paginacion.astro';
import SinPermiso from '../../../components/admin/SinPermiso.astro';
import Icono from '../../../components/ui/Icono.astro';
import { can } from '../../../admin/autorizacion';
import { permisoDePagina } from '../../../admin/guard';
import { leerPagina, totalPaginas } from '../../../admin/paginacion';
import { leerFiltroPedidos, listarPedidosPanel } from '../../../admin/pedidos';
import { ELIMINAR_REGISTROS } from '../../../admin/permisos';
import { ESTADOS_PEDIDO, NOMBRE_ESTADO_PEDIDO } from '../../../lib/estados';
import { formatoCOP } from '../../../lib/formato';

export const prerender = false;

const actor = permisoDePagina(Astro, 'pedidos:ver');
const veEliminados = can(actor, ELIMINAR_REGISTROS);
const estado = leerFiltroPedidos(Astro.url.searchParams.get('estado'), veEliminados);
const pagina = leerPagina(Astro.url.searchParams.get('pagina'));
const { pedidos, total } = actor ? await listarPedidosPanel({ estado, pagina }) : { pedidos: [], total: 0 };
// Una página que ya no existe (por ejemplo, tras eliminar) lleva a la última que sí.
if (actor && pagina > totalPaginas(total)) {
  const url = new URL(Astro.url);
  url.searchParams.set('pagina', String(totalPaginas(total)));
  return Astro.redirect(url.pathname + url.search, 303);
}
const FILTROS = [
  { valor: null, texto: 'Todos' },
  ...ESTADOS_PEDIDO.map((e) => ({ valor: e, texto: NOMBRE_ESTADO_PEDIDO[e] })),
  ...(veEliminados ? [{ valor: 'eliminados' as const, texto: 'Eliminados' }] : []),
];
const descarga = `/admin/pedidos/exportar${estado ? `?estado=${estado}` : ''}`;
const fecha = new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'America/Bogota',
});
const color: Record<string, string> = {
  pendiente: 'bg-dorado-400/30 text-azul-900',
  confirmado: 'bg-azul-led/10 text-azul-led',
  pagado: 'bg-azul-900 text-crema-50',
  entregado: 'bg-arena-100 text-tinta-600',
  cancelado: 'bg-error-700/10 text-error-700',
};
---

<AdminLayout titulo="Pedidos">
  {!actor ? (
    <SinPermiso />
  ) : (
    <>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h1 class="heading-3">Pedidos</h1>
        {can(actor, 'pedidos:exportar') && total > 0 && (
          <a href={descarga} class="btn-borde" download>
            <Icono nombre="arrow-down" class="size-5" />
            Descargar Excel
          </a>
        )}
      </div>
      <nav aria-label="Filtrar por estado" class="mt-6 flex flex-wrap gap-2">
        {FILTROS.map(({ valor, texto }) => (
          <a
            href={valor ? `/admin/pedidos?estado=${valor}` : '/admin/pedidos'}
            aria-current={valor === estado ? 'page' : undefined}
            class:list={[
              'btn-borde min-h-10 px-4 text-sm aria-[current=page]:bg-azul-900 aria-[current=page]:text-crema-50',
              valor === 'eliminados' && 'border-error-700/40 text-error-700',
            ]}
          >
            {texto}
          </a>
        ))}
      </nav>

      {pedidos.length ? (
        <div class="mt-8 rounded-3xl border border-azul-900/10 md:overflow-x-auto">
          <table class="block w-full text-left md:table md:min-w-3xl">
            <thead class="caption-3 hidden bg-arena-100 text-dorado-700 md:table-header-group">
              <tr>
                <th scope="col" class="px-4 py-3">
                  Código
                </th>
                <th scope="col" class="px-4 py-3">
                  Fecha
                </th>
                <th scope="col" class="px-4 py-3">
                  Cliente
                </th>
                <th scope="col" class="px-4 py-3 text-right">
                  Total
                </th>
                <th scope="col" class="px-4 py-3">
                  Estado
                </th>
                <th scope="col" class="px-4 py-3">
                  <span class="sr-only">Acciones</span>
                </th>
              </tr>
            </thead>
            <tbody class="body-6 block divide-y divide-azul-900/10 md:table-row-group">
              {pedidos.map((p) => (
                <tr class="block py-2 md:table-row md:py-0">
                  <td class="block px-4 py-1 md:table-cell md:py-3">
                    <a
                      href={`/admin/pedidos/${p.id}`}
                      class="title-3 underline decoration-dorado-400 underline-offset-4"
                    >
                      {p.codigo}
                    </a>
                  </td>
                  <td class="block px-4 py-1 text-tinta-600 md:table-cell md:py-3">
                    {fecha.format(p.fecha)}
                  </td>
                  <td class="block px-4 py-1 md:table-cell md:py-3">{p.cliente}</td>
                  <td class="block px-4 py-1 tabular-nums md:table-cell md:py-3 md:text-right">
                    {formatoCOP(p.totalCop)}
                  </td>
                  <td class="block px-4 py-2 md:table-cell md:py-3">
                    <span class:list={['caption-3 rounded-full px-2 py-1', color[p.estado]]}>
                      {NOMBRE_ESTADO_PEDIDO[p.estado]}
                    </span>
                    {estado === 'eliminados' && (
                      <span class="caption-3 ml-1 rounded-full bg-error-700/10 px-2 py-1 text-error-700">
                        Eliminado
                      </span>
                    )}
                  </td>
                  <td class="block px-4 py-2 md:table-cell md:py-3 md:text-right">
                    <a
                      href={`/admin/pedidos/${p.id}`}
                      class="btn-borde min-h-10 px-4 text-sm"
                      aria-label={`Gestionar pedido ${p.codigo}`}
                    >
                      Gestionar
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="body-3 mt-8 rounded-3xl bg-arena-100 p-6">
          {estado === 'eliminados'
            ? 'No hay pedidos eliminados.'
            : `No hay pedidos ${estado ? 'en este estado' : 'todavía'}.`}
        </p>
      )}
      <Paginacion pagina={pagina} total={total} nombre={total === 1 ? 'pedido' : 'pedidos'} />
    </>
  )}
</AdminLayout>
