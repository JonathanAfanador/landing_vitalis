---
import Pagina from '../../layouts/Pagina.astro';
import AvisoCarrito from '../../components/tienda/AvisoCarrito.astro';
import BotonAgregar from '../../components/tienda/BotonAgregar.astro';
import EstadoStock from '../../components/tienda/EstadoStock.astro';
import Icono from '../../components/ui/Icono.astro';
import { categorias, especies } from '../../data/vitalis';
import { obtenerMedicamento } from '../../db/queries/medicamentos';
import { formatoCOP } from '../../lib/formato';
import type { NombreIcono } from '../../lib/iconos';
import { cachearEnCdn, resultadoAgregar } from '../../lib/agregado';
import { SLUG } from '../../lib/validacion';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const m = SLUG.test(slug) ? await obtenerMedicamento(slug) : null;
if (!m) return new Response(null, { status: 404, statusText: 'No encontrado' });

const agregar = resultadoAgregar(Astro);
if (agregar.redireccion) return Astro.redirect(agregar.redireccion, 303);
cachearEnCdn(Astro);

const icono = (categorias.find((c) => c.slug === m.categoriaSlug)?.icono ?? 'pill') as NombreIcono;
const especiesDe = especies.filter((e) => m.especies.includes(e.slug));
const ficha = [
  { termino: 'Principio activo', valor: m.principioActivo },
  { termino: 'Presentación', valor: m.presentacion },
  { termino: 'Laboratorio', valor: m.laboratorio },
  { termino: 'Registro ICA', valor: m.registroIca },
  { termino: 'Categoría', valor: m.categoria },
  { termino: 'Para', valor: especiesDe.map((e) => e.nombre).join(' y ') || null },
].filter((f): f is { termino: string; valor: string } => Boolean(f.valor));
---

<Pagina
  titulo={`${m.nombre} · Medicamentos veterinarios Vitalis`}
  descripcion={`${m.nombre}: ${m.principioActivo}, ${m.presentacion}. Precio y disponibilidad en Vitalis Centro Veterinario, Girardot.`}
>
  <div class="mx-auto max-w-5xl">
    <a href="/tienda" class="body-6 inline-flex items-center gap-2 text-tinta-600 hover:text-azul-900">
      <Icono nombre="arrow-right" class="size-4 rotate-180" />
      Volver a la tienda
    </a>

    <div class="mt-6 grid gap-10 md:grid-cols-2">
      <div class="grid aspect-square place-items-center rounded-3xl bg-arena-100 text-dorado-700">
        {m.imagen ? (
          <img src={m.imagen} alt={m.nombre} class="size-full rounded-3xl object-contain p-8" />
        ) : (
          <Icono nombre={icono} class="size-24" />
        )}
      </div>

      <div>
        <p class="caption-3 text-dorado-700">{m.categoria}</p>
        <h1 class="heading-2 mt-3">{m.nombre}</h1>
        <p class="heading-5 mt-6">{formatoCOP(m.precioCop)}</p>
        <div class="mt-2">
          <EstadoStock stock={m.stock} />
        </div>

        {m.requiereFormula && (
          <p class="body-6 mt-6 flex gap-3 rounded-2xl bg-azul-900 p-4 text-crema-50">
            <Icono nombre="prescription" class="size-5 shrink-0 text-dorado-400" />
            Requiere fórmula médica veterinaria. Te la pediremos por WhatsApp antes de confirmar el pedido.
          </p>
        )}

        <BotonAgregar slug={m.slug} nombre={m.nombre} stock={m.stock} conCantidad class="mt-8" />

        <dl class="mt-10 divide-y divide-azul-900/10 border-y border-azul-900/10">
          {ficha.map((f) => (
            <div class="grid grid-cols-[2fr_3fr] gap-4 py-3">
              <dt class="body-6 text-tinta-600">{f.termino}</dt>
              <dd class="body-6">{f.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
  <AvisoCarrito mensaje={agregar.mensaje} error={agregar.error} />
</Pagina>
