---
import Pending from '../ui/Pending.astro';
import { comoPedir } from '../../data/vitalis';
---

<section id="como-pedir" class="bg-azul-900 px-4 py-16 text-crema-50 sm:px-6 lg:py-24">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-170" data-reveal>
      <p class="caption-3 text-dorado-400">Cómo pedir</p>
      <h2 class="heading-2 mt-3">Tu pedido en tres pasos</h2>
    </div>
    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {comoPedir.map((paso, i) => (
        <li class="border-t border-crema-50/20 pt-6" data-reveal>
          <span class="font-serif text-5xl font-semibold text-dorado-400">{i + 1}</span>
          <h3 class="heading-6 mt-4">{paso.titulo}</h3>
          <p class="body-3 mt-2 text-crema-50/80">{paso.texto}</p>
        </li>
      ))}
    </ol>
    <Pending dato="medios de pago y zonas de domicilio" class="mt-8" />
  </div>
</section>
