---
import Icono from '../ui/Icono.astro';
import { cta } from '../../data/vitalis';
---

<section class="bg-azul-900 px-4 py-24 text-center text-crema-50 sm:px-6">
  <div class="mx-auto max-w-170" data-reveal>
    <h2 class="heading-2">Los medicamentos de tu mascota, sin vueltas</h2>
    <p class="body-3 mt-4 text-crema-50/80">
      Busca lo que necesitas, deja tus datos y te confirmamos por WhatsApp.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={cta.principal.href} class="btn-dorado">
        {cta.principal.texto}
        <Icono nombre="arrow-right" class="size-5" />
      </a>
      <a
        href={cta.secundario.href}
        class="btn button-md border border-crema-50/30 text-crema-50 hover:bg-azul-700"
      >
        {cta.secundario.texto}
      </a>
    </div>
  </div>
</section>
