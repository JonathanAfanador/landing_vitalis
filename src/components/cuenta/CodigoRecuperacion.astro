---
// Muestra un código de recuperación recién generado. Es la única vez que se ve: en la base solo queda su scrypt.
import Icono from '../ui/Icono.astro';

interface Props {
  codigo: string;
  class?: string;
}

const { codigo, class: className = '' } = Astro.props;
---

<div
  class:list={['rounded-3xl border-2 border-dashed border-dorado-400 bg-crema-50 p-6', className]}
  role="status"
>
  <p class="caption-3 flex items-center gap-2 text-dorado-700">
    <Icono nombre="shield-check" class="size-5" />
    Tu código de recuperación
  </p>
  <p class="mt-3 font-mono text-2xl font-semibold tracking-wider text-azul-900 select-all sm:text-3xl">
    {codigo}
  </p>
  <p class="body-6 mt-3 text-tinta-600">
    Guárdalo en un lugar seguro: tómale una foto o anótalo. Si olvidas tu contraseña, con tu correo y este
    código pones una nueva tú mismo. <strong class="text-azul-900">Solo se muestra esta vez</strong> y sirve
    una sola vez.
  </p>
</div>
