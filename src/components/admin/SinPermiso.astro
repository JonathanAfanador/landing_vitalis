---
import Icono from '../ui/Icono.astro';
---

<div class="mx-auto flex max-w-md flex-col items-center text-center">
  <span class="grid size-12 place-items-center rounded-full bg-dorado-400/25 text-dorado-700">
    <Icono nombre="shield-check" />
  </span>
  <h1 class="heading-4 mt-6">No tienes acceso a esta sección</h1>
  <p class="body-3 mt-2 text-tinta-600">
    Si lo necesitas para tu trabajo, pídele el permiso a un superadmin.
  </p>
  <a href="/admin" class="btn-borde mt-6">
    Volver al resumen
  </a>
</div>
