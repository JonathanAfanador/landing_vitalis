---
import Icono from '../ui/Icono.astro';
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-24 z-40 flex justify-center px-4 opacity-0 transition duration-300 ease-base data-[visible]:pointer-events-auto data-[visible]:opacity-100"
  data-aviso-carrito
>
  <div class="flex items-center gap-3 rounded-full bg-azul-900 py-2 pr-2 pl-4 text-crema-50 shadow-lg">
    <Icono nombre="check-circle" class="size-5 text-dorado-400" />
    <p class="body-6" role="status" aria-live="polite" data-aviso-texto></p>
    <a href="/pedido" class="btn button-sm min-h-10 bg-dorado-400 px-4 text-azul-900 hover:bg-arena-100">
      Ver pedido
    </a>
  </div>
</div>

<script>
  import { agregar } from '../../scripts/cart';

  const aviso = document.querySelector<HTMLElement>('[data-aviso-carrito]');
  const texto = document.querySelector<HTMLElement>('[data-aviso-texto]');
  let ocultar: number | undefined;

  document.addEventListener('click', (event) => {
    const boton = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-agregar]');
    const slug = boton?.dataset.agregar;
    if (!boton || !slug) return;
    const campoCantidad = boton.dataset.cantidad ? document.getElementById(boton.dataset.cantidad) : null;
    const cantidad =
      campoCantidad instanceof HTMLInputElement ? Math.max(1, Number(campoCantidad.value) || 1) : 1;
    agregar(slug, cantidad);
    if (!aviso || !texto) return;
    texto.textContent = `Agregaste ${boton.dataset.nombre ?? 'el medicamento'} a tu pedido.`;
    aviso.dataset.visible = '';
    window.clearTimeout(ocultar);
    ocultar = window.setTimeout(() => delete aviso.dataset.visible, 4000);
  });
</script>
