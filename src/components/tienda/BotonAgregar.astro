---
// "Agregar al pedido" es un formulario real: sin JavaScript funciona con una recarga; con JavaScript,
// AvisoCarrito lo envía sin recargar. Se envía a la misma página para conservar filtros y búsqueda.
import { actions } from 'astro:actions';
import Icono from '../ui/Icono.astro';

interface Props {
  slug: string;
  nombre: string;
  stock: number;
  conCantidad?: boolean;
  class?: string;
}

const { slug, nombre, stock, conCantidad = false, class: className = '' } = Astro.props;
const destino = new URL(Astro.url);
destino.searchParams.delete('agregado');
destino.searchParams.set('_action', actions.carrito.agregar.toString().replace('?_action=', ''));
---

{stock > 0 ? (
  <form
    method="POST"
    action={destino.pathname + destino.search}
    class:list={['flex flex-wrap items-end gap-3', className]}
    data-agregar
  >
    <input type="hidden" name="slug" value={slug} />
    {conCantidad && (
      <div>
        <label for={`cantidad-${slug}`} class="caption-3 mb-2 block text-dorado-700">
          Cantidad
        </label>
        <input
          id={`cantidad-${slug}`}
          name="cantidad"
          type="number"
          inputmode="numeric"
          min="1"
          max={Math.min(stock, 99)}
          value="1"
          required
          class="min-h-11 w-24 rounded-full border border-azul-900/20 bg-crema-50 px-4 text-base"
        />
      </div>
    )}
    <button
      type="submit"
      class="btn-principal"
      aria-label={`Agregar ${nombre} al pedido`}
      data-nombre={nombre}
    >
      <Icono nombre="plus" class="size-5" />
      Agregar
    </button>
  </form>
) : (
  <button type="button" class:list={['btn button-md bg-arena-100 text-tinta-600', className]} disabled>
    Agotado
  </button>
)}
