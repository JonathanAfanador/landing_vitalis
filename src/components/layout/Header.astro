---
import isotipo from '../../assets/brand/isotipo.svg';
import { cta, navegacion, negocio } from '../../data/vitalis';

const enPortada = Astro.url.pathname === '/';
const enlace = (href: string) => (href.startsWith('#') && !enPortada ? `/${href}` : href);
---

<header class="fixed inset-x-0 top-3 z-50 flex justify-center px-4">
  <div class="flex w-full max-w-5xl items-center justify-between gap-4 rounded-full border border-azul-900/10 bg-crema-50/80 py-2 pr-2 pl-4 shadow-sm backdrop-blur-md lg:w-auto lg:justify-start">
    <a href="/" class="flex items-center gap-2 rounded-full" aria-label={`${negocio.nombre}, inicio`}>
      <img src={isotipo.src} alt="" width="40" height="31" class="h-8 w-auto" />
      <span class="font-serif text-2xl font-semibold tracking-wide uppercase">{negocio.nombreCorto}</span>
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {navegacion.map((item) => (
          <li>
            <a
              href={enlace(item.href)}
              data-nav
              class="rounded-full px-3 py-2 text-sm font-medium text-tinta-600 transition duration-300 ease-base hover:text-azul-900 aria-[current=true]:text-azul-900 aria-[current=true]:underline aria-[current=true]:decoration-dorado-400 aria-[current=true]:decoration-2 aria-[current=true]:underline-offset-8"
            >
              {item.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={cta.principal.href}
        class="btn button-sm hidden min-h-10 bg-azul-900 px-4 text-crema-50 hover:bg-azul-700 sm:inline-flex"
      >
        {cta.principal.texto}
      </a>
      <button
        type="button"
        class="relative grid size-11 place-items-center rounded-full transition duration-300 ease-base hover:bg-arena-100 lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-menu-toggle
      >
        <span class="sr-only">Abrir menú</span>
        <span
          class="absolute h-0.5 w-5 -translate-y-1 rounded-full bg-azul-900 transition duration-500 ease-base"
          data-linea="1"
        ></span>
        <span
          class="absolute h-0.5 w-5 translate-y-1 rounded-full bg-azul-900 transition duration-500 ease-base"
          data-linea="2"
        ></span>
      </button>
    </div>
  </div>
</header>

<div
  id="menu-movil"
  class="invisible fixed inset-0 z-40 flex flex-col bg-crema-50/95 px-6 pt-24 pb-10 opacity-0 backdrop-blur-xl transition duration-500 ease-base lg:hidden"
  data-menu
  data-lenis-prevent
>
  <nav aria-label="Menú móvil" class="flex-1">
    <ul class="flex flex-col gap-2">
      {navegacion.map((item, i) => (
        <li
          class="translate-y-6 opacity-0 transition duration-500 ease-base"
          style={`--i:${i}`}
          data-menu-item
        >
          <a href={enlace(item.href)} class="heading-3 block py-2">
            {item.texto}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div
    class="flex flex-col gap-3 translate-y-6 opacity-0 transition duration-500 ease-base"
    style={`--i:${navegacion.length}`}
    data-menu-item
  >
    <a href={cta.principal.href} class="btn-principal w-full">
      {cta.principal.texto}
    </a>
    <a href={enlace(cta.secundario.href)} class="btn-borde w-full">
      {cta.secundario.texto}
    </a>
  </div>
</div>

<style>
  [data-menu].is-open {
    visibility: visible;
    opacity: 1;
  }
  [data-menu].is-open [data-menu-item] {
    opacity: 1;
    transform: none;
    transition-delay: min(calc(var(--i) * 60ms), 340ms);
  }
  [aria-expanded='true'] [data-linea='1'] {
    transform: rotate(45deg);
  }
  [aria-expanded='true'] [data-linea='2'] {
    transform: rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-menu-item],
    [data-linea] {
      transform: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const etiqueta = toggle.querySelector('.sr-only');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (etiqueta) etiqueta.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      menu.classList.toggle('is-open', open);
      menu.inert = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.dispatchEvent(new CustomEvent(open ? 'scroll:lock' : 'scroll:unlock'));
      if (open) menu.querySelector('a')?.focus();
    };

    menu.inert = true;
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
